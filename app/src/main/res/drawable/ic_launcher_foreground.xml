<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. 108dp canvas; content kept inside the 66dp safe zone
  (x/y 21..87). A white heart with an ECG pulse line crossing it — the pulse is
  drawn in the launcher background color so it reads as a cut-out through the heart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Heart -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,78
                           C54,78 26,56 26,40
                           C26,28 35,22 44,28
                           C48,30 51,34 54,40
                           C57,34 60,30 64,28
                           C73,22 82,28 82,40
                           C82,56 54,78 54,78 Z" />

    <!-- Pulse / ECG line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00696B"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M26,52 L40,52 L46,38 L52,64 L58,44 L64,52 L82,52" />

</vector>
