rules_version = '2';

// KinPulse Firestore security rules.
//
// Schema (see app/src/main/java/com/kinpulse/app/data/HealthRepository.kt):
//   profiles/{profileId}                      name, ownerId, memberIds[], roles{uid: Role}, memberNames{uid: name}, createdAt
//   profiles/{profileId}/readings/{readingId}  one sugar or BP measurement
//   profiles/{profileId}/invites/{email}       pending invite for a family member, keyed by lower-case email
//
// Roles: OWNER (full control), EDITOR ("can add & view"), VIEWER ("can view only").
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----

    function signedIn() {
      return request.auth != null;
    }

    // Email/password sign-in requires a verified email before it can act on shared data.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Reads the target profile document's data. Used by the helpers below; each call is a
    // `get`, so keep usages minimal.
    function profileData(pid) {
      return get(/databases/$(database)/documents/profiles/$(pid)).data;
    }

    function isMember(pid) {
      return signedIn() && request.auth.uid in profileData(pid).memberIds;
    }

    function canEdit(pid) {
      return signedIn() && profileData(pid).roles.get(request.auth.uid, '') in ['OWNER', 'EDITOR'];
    }

    function isOwner(pid) {
      return signedIn() && profileData(pid).ownerId == request.auth.uid;
    }

    // ---- Profiles ----

    match /profiles/{pid} {

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Creating a profile: the creator becomes its sole OWNER.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'OWNER'
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds', 'roles', 'memberNames', 'createdAt']);

      // Update is allowed for exactly three shapes of change:
      allow update: if signedIn() && (
        // (a) the owner manages the profile: rename it, re-role members, or remove members —
        //     but never add a member directly (that only happens by accepting an invite).
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.roles.get(resource.data.ownerId, '') == 'OWNER'
          && request.resource.data.roles.values().hasOnly(['OWNER', 'EDITOR', 'VIEWER'])
          && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
          && request.resource.data.memberIds.toSet() == request.resource.data.roles.keys().toSet()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
        )
        ||
        // (b) a non-owner member leaves the profile on their own.
        (
          request.auth.uid in resource.data.memberIds
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'memberNames'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          && !(request.auth.uid in request.resource.data.roles)
          && !(request.auth.uid in request.resource.data.memberNames)
        )
        ||
        // (c) an invitee accepts a pending invite for their (verified) email, joining as the
        //     role the invite grants.
        (
          verified()
          && !(request.auth.uid in resource.data.memberIds)
          && exists(/databases/$(database)/documents/profiles/$(pid)/invites/$(myEmail()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'memberNames'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys() == [request.auth.uid].toSet()
          && request.resource.data.roles[request.auth.uid] ==
               get(/databases/$(database)/documents/profiles/$(pid)/invites/$(myEmail())).data.role
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // ---- Readings ----

      match /readings/{rid} {

        function valid(data) {
          return data.keys().hasOnly(
                   ['type', 'takenAt', 'sugarMgDl', 'sugarContext', 'systolic', 'diastolic', 'pulse', 'note', 'addedBy', 'addedByName']
                 )
            && data.type in ['SUGAR', 'BP']
            && data.takenAt is timestamp
            && data.note is string && data.note.size() <= 500
            && (
                 data.type == 'SUGAR'
                   ? (data.sugarMgDl is int && data.sugarMgDl >= 10 && data.sugarMgDl <= 1000)
                   : (
                       data.systolic is int && data.systolic >= 40 && data.systolic <= 300
                       && data.diastolic is int && data.diastolic >= 20 && data.diastolic <= 200
                       && (data.pulse == null || (data.pulse is int && data.pulse >= 20 && data.pulse <= 250))
                     )
               );
        }

        allow read: if isMember(pid);
        allow create: if canEdit(pid) && request.resource.data.addedBy == request.auth.uid && valid(request.resource.data);
        allow update: if canEdit(pid) && valid(request.resource.data) && request.resource.data.addedBy == resource.data.addedBy;
        allow delete: if canEdit(pid);
      }

      // ---- Invites ----

      match /invites/{email} {
        allow read: if isMember(pid) || (verified() && email == myEmail());
        allow create, update: if isOwner(pid)
          && request.resource.data.email == email
          && email == email.lower()
          && request.resource.data.role in ['EDITOR', 'VIEWER']
          && request.resource.data.profileId == pid;
        allow delete: if isOwner(pid) || (verified() && email == myEmail());
      }
    }

    // Lets a signed-in, verified user find invites addressed to them across all profiles, via
    // `collectionGroup("invites").whereEqualTo("email", ...)`.
    match /{path=**}/invites/{email} {
      allow read: if verified() && resource.data.email == myEmail();
    }
  }
}
